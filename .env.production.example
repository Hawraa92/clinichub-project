# ==========================================================
# ClinicHub production environment example
# Replace placeholders inside the hosting platform.
# Never place real secrets in this example file.
# ==========================================================

DEBUG=False
SECRET_KEY=GENERATE_A_NEW_STRONG_PRODUCTION_SECRET_KEY

SITE_URL=https://your-clinichub-domain.example
ALLOWED_HOSTS=your-clinichub-domain.example
SECURE_SSL_REDIRECT=True

# PostgreSQL production database
DB_NAME=PRODUCTION_DATABASE_NAME
DB_USER=PRODUCTION_DATABASE_USER
DB_PASSWORD=PRODUCTION_DATABASE_PASSWORD
DB_HOST=PRODUCTION_DATABASE_HOST
DB_PORT=5432

# Initial/system administrator
ADMIN_EMAIL=admin@example.com

# Email service
DEFAULT_FROM_EMAIL=ClinicHub <no-reply@example.com>
EMAIL_HOST=SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=SMTP_USERNAME
EMAIL_HOST_PASSWORD=SMTP_PASSWORD
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Public model configuration
DIABETES_MODEL_FILENAME=MODEL_FILENAME
DIABETES_MODEL_NAME=MODEL_NAME
DIABETES_OVERWRITE_STATUS=False
DIABETES_RISK_MEDIUM=0.40
DIABETES_RISK_HIGH=0.70

# Licensing
LICENSE_ENFORCEMENT_ENABLED=True
LICENSE_INSTALLATION_NAME=ClinicHub Production
LICENSE_SERVER_URL=https://license-server.example
LICENSE_SERVER_API_KEY=PRODUCTION_LICENSE_API_KEY
LICENSE_ONLINE_CHECK_HOURS=24
LICENSE_ONLINE_TIMEOUT=10
